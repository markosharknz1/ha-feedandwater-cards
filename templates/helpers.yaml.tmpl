# ============================================================================
# HELPERS — {{TITLE}}
# Generated from templates/helpers.yaml.tmpl — do not hand-edit if you plan
# to regenerate later; edit the template instead.
# ============================================================================

input_select:
  {{SLUG}}_flow_mode:
    name: "{{TITLE}} Flow Mode"
    icon: mdi:waves
    options:
      - "Reef Crest"
      - "Nutrient Export"
      - "Feed"

input_boolean:
  {{SLUG}}_feed_mode:
    name: "{{TITLE}} Feed Mode"
    icon: mdi:food-drumstick

  {{SLUG}}_water_change_mode:
    name: "{{TITLE}} Water Change Mode"
    icon: mdi:water-sync

input_number:
  {{SLUG}}_feed_duration_minutes:
    name: "{{TITLE}} Feed Mode Duration"
    icon: mdi:timer-outline
    mode: slider
    min: 1
    max: 60
    step: 1
    unit_of_measurement: min
    initial: 20

  {{SLUG}}_feed_return_pump_percent:
    name: "{{TITLE}} Return Pump Feed Speed"
    icon: mdi:speedometer-slow
    mode: slider
    min: 0
    max: 100
    step: 5
    unit_of_measurement: "%"
    initial: 30

  {{SLUG}}_feed_skimmer_extra_minutes:
    name: "{{TITLE}} Skimmer Extra Off Time (after feed ends)"
    icon: mdi:timer-plus-outline
    mode: slider
    min: 0
    max: 30
    step: 1
    unit_of_measurement: min
    initial: 10

  {{SLUG}}_water_change_volume_liters:
    name: "{{TITLE}} Last Water Change Volume"
    icon: mdi:cup-water
    min: 0
    max: 500
    step: 1
    unit_of_measurement: L

  {{SLUG}}_wc_wavemaker_delay:
    name: "{{TITLE}} Return Pump \u2192 Wavemaker Delay"
    icon: mdi:timer-sand
    mode: slider
    min: 0
    max: 30
    step: 1
    unit_of_measurement: min
    initial: 5

  {{SLUG}}_wc_skimmer_delay:
    name: "{{TITLE}} Wavemaker \u2192 Skimmer Delay"
    icon: mdi:timer-sand
    mode: slider
    min: 0
    max: 30
    step: 1
    unit_of_measurement: min
    initial: 10

input_datetime:
  {{SLUG}}_last_water_change:
    name: "{{TITLE}} Last Water Change"
    has_date: true
    has_time: true

input_text:
  {{SLUG}}_tracked_devices:
    name: "{{TITLE}} Tracked Devices (comma-separated entity_ids)"
    icon: mdi:format-list-bulleted
    max: 255
    initial: ""

  {{SLUG}}_feed_return_pump_prior:
    name: "{{TITLE}} Return Pump Speed Before Feed (internal storage)"
    icon: mdi:content-save-outline
    max: 255
    initial: ""

timer:
  {{SLUG}}_feed_mode:
    name: "{{TITLE}} Feed Mode Timer (wavemakers)"
    duration: "00:20:00"

  {{SLUG}}_feed_skimmer_off:
    name: "{{TITLE}} Feed Mode Timer (skimmer)"
    duration: "00:30:00"

  {{SLUG}}_skimmer_restart_delay:
    name: "{{TITLE}} Skimmer Restart Delay"
    duration: "00:05:00"

  {{SLUG}}_water_change_safety:
    name: "{{TITLE}} Water Change Safety Timer"
    duration: "02:00:00"

  {{SLUG}}_wc_wavemaker_countdown:
    name: "{{TITLE}} Wavemaker Restart Countdown"
    duration: "00:05:00"

  {{SLUG}}_wc_skimmer_countdown:
    name: "{{TITLE}} Skimmer Restart Countdown"
    duration: "00:10:00"
