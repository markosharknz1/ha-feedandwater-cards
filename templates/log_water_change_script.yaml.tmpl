script:
  {{SLUG}}_log_water_change:
    alias: "{{TITLE}} - Log Water Change Now"
    sequence:
      - action: input_datetime.set_datetime
        target:
          entity_id: input_datetime.{{SLUG}}_last_water_change
        data:
          datetime: "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}"
    mode: single

  {{SLUG}}_start_feed_indefinite:
    alias: "{{TITLE}} - Start Feed (Until I Stop)"
    sequence:
      # Sets duration to the slider's max (see feed_duration_minutes in
      # helpers.yaml.tmpl) rather than a true no-timer mode — far longer
      # than any real feeding session, and tapping "Stop Feeding" at any
      # point already resumes wavemakers/pump immediately via the
      # blueprint's existing early-cancel branch. Keep this value in sync
      # with that slider's max if it ever changes.
      - action: input_number.set_value
        target:
          entity_id: input_number.{{SLUG}}_feed_duration_minutes
        data:
          value: 60
      - action: input_boolean.turn_on
        target:
          entity_id: input_boolean.{{SLUG}}_feed_mode
    mode: single
